# Copy this file to `.env` (same folder), paste your API key below, save.
# NEVER commit .env to git. NEVER paste the key into chat or screenshots.

# ---------- LLM provider (OpenAI-compatible endpoint) ----------
# Defaults point to Groq. Sign up at https://console.groq.com → API Keys.
# Verify the model id at https://console.groq.com/docs/models before changing it.
LLM_BASE_URL=https://api.groq.com/openai/v1/
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
# Groq doesn't currently serve embeddings. Leave empty; retrieval uses BM25.
LLM_EMBED_MODEL=

# ---------- Server ----------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8010
# Comma-separated origins allowed by CORS. Set this to exactly your
# frontend's URL in production. Leaving localhost in a public deploy means
# anyone's local app can read your API from their browser.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- Security ----------
# When set, every /api/* request (except /api/health and the HMAC-verified
# webhook) must send `Authorization: Bearer <API_AUTH_TOKEN>`. Required in
# production. Generate once: `python -c "import secrets; print(secrets.token_urlsafe(32))"`.
API_AUTH_TOKEN=
# Response hardening headers (CSP, X-Frame-Options, HSTS, ...).
# Leave on unless you're embedding the API elsewhere.
SECURITY_HEADERS_ENABLED=true

# Rate limits (empty disables). Applied per client IP.
RATE_LIMIT_LLM=20/minute
RATE_LIMIT_DEFAULT=120/minute

# ---------- Storage ----------
DATA_DIR=./data
SQLITE_PATH=./data/kt.db
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=25

# ---------- Optional integrations ----------
# Slack: incoming-webhook URL. When set, the backend posts a summary to this channel
# after gap analysis or when drift is detected. Leave empty to disable.
SLACK_WEBHOOK_URL=
# GitHub webhook: shared secret used to verify payloads at /api/webhooks/github.
# Must match the secret you set in your repo's webhook configuration. Leave empty to
# accept unsigned payloads (fine for local demos; set in production).
GITHUB_WEBHOOK_SECRET=
# Public base URL of this app, used only to build links in Slack messages.
PUBLIC_BASE_URL=
